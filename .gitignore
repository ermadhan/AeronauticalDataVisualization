# ==============================================================================
# AeroOps - Git Ignore Configuration
# ==============================================================================

# Python bytecode & cache
__pycache__/
*.py[cod]
*$py.class
*.pyd

# Generated Local SQLite Database
*.db
*.sqlite
*.sqlite3

# Python Virtual Environments
venv/
.venv/
env/
ENV/
env.bak/
venv.bak/

# Operating System Files
.DS_Store
Thumbs.db
Desktop.ini
ehthumbs.db
$RECYCLE.BIN/

# IDE & Editor Configuration
.vscode/
.idea/
*.sublime-project
*.sublime-workspace
*.swp
*~

# Logs and runtime artifacts
*.log
*.tmp
*.temp
